{
  // WorkFlowSync configuration. Copy to config.json next to WorkFlowSync.exe and adjust.
  // Times use .NET TimeSpan format: "d.hh:mm:ss" (365 days = "365.00:00:00", 30 minutes = "00:30:00").
  "pairs": [
    {
      "name": "vrp",
      "source": "E:\\vrp",
      "target": "D:\\OneDrive\\Робоча папка",
      "links": "follow",
      "retention": "365.00:00:00",
      "exclude": [
        "\\Друга дисциплінарна палата\\*Робочий.docx"
      ]
    }
  ],
  "statePath": "state.db",
  "logPath": "logs",
  "interval": "00:30:00",
  "scanParallelism": 8,
  "scanBufferSize": 262144
}
