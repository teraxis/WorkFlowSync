{
  // WorkFlowSync configuration. Copy to config.json next to WorkFlowSync.exe / wfs.exe and adjust,
  // or simply start WorkFlowSync.exe and use the «Папки» / «Налаштування» tabs.
  // Times use .NET TimeSpan format: "d.hh:mm:ss" (365 days = "365.00:00:00", 30 minutes = "00:30:00").
  "pairs": [
    {
      "name": "test",
      // "mirror" — у один бік із памʼяттю (типово), "twoWay" — повна синхронізація в обидва боки
      "mode": "mirror",
      "source": "S:\\tmp\\test\\Засідання ВРП",
      "target": "D:\\OneDrive\\tmp\\test",
      "links": "follow",
      "retention": null,
      "exclude": [
        "~$*",
        "*.tmp"
      ]
    }
  ],
  "statePath": "state.db",
  "logPath": "logs",
  "logKeepDays": 30,
  "interval": "00:30:00",
  "scanParallelism": 8,
  "scanBufferSize": 262144
}
