{
  // WorkFlowSync configuration. Copy to config.json next to WorkFlowSync.exe / wfs.exe and adjust,
  // or simply start WorkFlowSync.exe and use the «Папки» / «Налаштування» tabs.
  // Times use .NET TimeSpan format: "d.hh:mm:ss" (365 days = "365.00:00:00", 30 minutes = "00:30:00").
  "pairs": [
    {
      "name": "test",
      // "mirror" — у один бік із памʼяттю (типово), "twoWay" — повна синхронізація в обидва боки
      "mode": "mirror",
      "source": "S:\\tmp\\test\\Засідання ВРП",
      "target": "D:\\OneDrive\\tmp\\test",
      "links": "follow",
      // "auto" (типово) — стежити за змінами там, де сховище це дозволяє; "on" — завжди; "off" — лише за інтервалом
      "watch": "auto",
      // "skip" (типово) — файли, що лежать лише в хмарі, не копіювати; "hydrate" — завантажувати. Лише для "twoWay"
      "cloudFiles": "skip",
      // Переносити лише те, що зʼявилося за останні N днів. null — будь-якої давності.
      // Старіші файли лишаються в джерелі недоторканими: вони просто не копіюються і не оновлюються.
      // З локальної теки цей фільтр не видаляє нічого. Лише для "mirror".
      "maxAge": null,
      // Автоочищення: переносити в Кошик наші копії, додані понад N днів тому. null — вимкнено.
      // Вік рахується від дати, коли програма побачила файл, а не від дати самого файлу.
      // У джерелі не зникає нічого. Лише для "mirror".
      "autoClean": null,
      "exclude": [
        "~$*",
        "*.tmp"
      ]
    }
  ],
  "statePath": "state.db",
  "logPath": "logs",
  "logKeepDays": 30,
  "interval": "00:30:00",
  // balanced (типово) / full / low — скільки процесора дозволено зайняти проходу
  "cpuLoad": "balanced",
  "scanParallelism": 8,
  "scanBufferSize": 262144
}
