<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkFlowSync.App.ViewModels"
        xmlns:loc="using:WorkFlowSync.App.Localization"
        x:Class="WorkFlowSync.App.Views.CloudFolderPickerDialog"
        x:DataType="vm:CloudFolderPickerViewModel"
        Title="{loc:Loc cloud_picker.title}"
        Width="680" Height="540"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceCard}">

    <Window.Styles>
        <Style Selector="Button.tab-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,8,14,10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tab-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.tab-btn.active">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.tab-btn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.tab-btn.active Path.ico">
            <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="14,16" Background="{DynamicResource SurfaceRail}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                        Background="{DynamicResource AccentSubtle}" Margin="0,0,14,0">
                    <Path Classes="ico" Data="{StaticResource IconCloud}" Width="20" Height="20"
                          Stroke="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc cloud_picker.title}" Classes="h2" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AccountTitle}" Classes="caption" Classes.secondary="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs Bar -->
        <Border DockPanel.Dock="Top" Padding="12,4,12,0" Background="{DynamicResource SurfaceRail}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <!-- Tab: My Drive -->
                <Button Classes="tab-btn" Classes.active="{Binding IsMyDriveTab}"
                        Command="{Binding SwitchTabCommand}" CommandParameter="my_drive">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="ico" Data="{StaticResource IconFolders}" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc cloud_picker.tab_my_drive}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Tab: Shared Documents -->
                <Button Classes="tab-btn" Classes.active="{Binding IsSharedTab}"
                        Command="{Binding SwitchTabCommand}" CommandParameter="shared">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="ico" Data="{StaticResource IconUsers}" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc cloud_picker.tab_shared}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Bottom Action Bar -->
        <Border DockPanel.Dock="Bottom" Padding="14,14" Background="{DynamicResource SurfaceRail}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0" Command="{Binding SelectCurrentFolderCommand}"
                        Content="{Binding SelectCurrentButtonText}" Classes="outline"
                        IsEnabled="{Binding CanSelectCurrentFolder}"
                        IsVisible="{Binding CanSelectCurrentFolder}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc common.cancel}" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Content="{loc:Loc cloud_picker.select}" Command="{Binding ConfirmSelectionCommand}"
                            Classes="primary" MinWidth="110" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Toolbar & Breadcrumbs -->
        <Border DockPanel.Dock="Top" Padding="12,10" Background="{DynamicResource SurfaceSubtle}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <Button Grid.Column="0" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}"
                        Classes="icon-btn" ToolTip.Tip="{loc:Loc cloud_picker.up}" Margin="0,0,6,0">
                    <Path Classes="ico" Data="{StaticResource IconArrowLeft}" Width="16" Height="16" />
                </Button>
                <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                        Classes="icon-btn" ToolTip.Tip="{loc:Loc common.retry}" Margin="0,0,12,0">
                    <Path Classes="ico" Data="{StaticResource IconRefresh}" Width="16" Height="16" />
                </Button>

                <!-- Breadcrumbs list -->
                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BreadcrumbItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                    <Button Classes="link" Content="{Binding Name}"
                                            Command="{Binding $parent[ItemsControl].((vm:CloudFolderPickerViewModel)DataContext).NavigateToBreadcrumbCommand}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="/" Classes="caption" Classes.secondary="True" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" IsVisible="{Binding IsLoading}" />

        <!-- Main Content Area -->
        <Grid>
            <!-- Error State -->
            <Border IsVisible="{Binding HasError}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ErrorMessage}" Classes="danger" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" />
                    <Button Content="{loc:Loc common.retry}" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Empty State -->
            <StackPanel IsVisible="{Binding !Folders.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding EmptyMessage}" Classes="secondary" TextAlignment="Center" />
            </StackPanel>

            <!-- Folders List -->
            <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                     DoubleTapped="OnFolderDoubleTapped"
                     Background="Transparent" BorderThickness="0" Padding="4">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CloudFolderItemViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,6">
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                                    Background="{DynamicResource AccentSubtle}" Margin="0,0,12,0">
                                <Path Classes="ico" Data="{StaticResource IconFolders}" Width="16" Height="16"
                                      Stroke="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                                <Border IsVisible="{Binding IsShortcut}" CornerRadius="4" Background="{DynamicResource SurfaceSubtle}"
                                        Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc cloud_picker.shortcut_tag}" Classes="caption" Classes.secondary="True" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding ModifiedDisplay}" Classes="caption"
                                       Classes.secondary="True" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
