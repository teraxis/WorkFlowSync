<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkFlowSync.App.ViewModels"
        xmlns:loc="using:WorkFlowSync.App.Localization"
        x:Class="WorkFlowSync.App.Views.CloudFolderPickerDialog"
        x:DataType="vm:CloudFolderPickerViewModel"
        Title="{loc:Loc cloud_picker.title}"
        Width="680" Height="540"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceCard}">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="20,16" Background="{DynamicResource SurfaceRail}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                        Background="{DynamicResource AccentSubtle}" Margin="0,0,14,0">
                    <Path Classes="ico" Data="{StaticResource IconCloud}" Width="20" Height="20"
                          Stroke="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc cloud_picker.title}" Classes="h2" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AccountTitle}" Classes="caption" Classes.secondary="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Action Bar -->
        <Border DockPanel.Dock="Bottom" Padding="20,14" Background="{DynamicResource SurfaceRail}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0" Command="{Binding SelectCurrentFolderCommand}"
                        Content="{Binding SelectCurrentButtonText}" Classes="outline" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc common.cancel}" Command="{Binding CancelCommand}" MinWidth="90" />
                    <Button Content="{loc:Loc cloud_picker.select}" Command="{Binding ConfirmSelectionCommand}"
                            Classes="primary" MinWidth="110" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Toolbar & Breadcrumbs -->
        <Border DockPanel.Dock="Top" Padding="16,10" Background="{DynamicResource SurfaceSubtle}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <Button Grid.Column="0" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}"
                        Classes="icon-btn" ToolTip.Tip="{loc:Loc cloud_picker.up}" Margin="0,0,6,0">
                    <Path Classes="ico" Data="{StaticResource IconArrowLeft}" Width="16" Height="16" />
                </Button>
                <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                        Classes="icon-btn" ToolTip.Tip="{loc:Loc common.retry}" Margin="0,0,12,0">
                    <Path Classes="ico" Data="{StaticResource IconRefresh}" Width="16" Height="16" />
                </Button>

                <!-- Breadcrumbs list -->
                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BreadcrumbItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                    <Button Classes="link" Content="{Binding Name}"
                                            Command="{Binding $parent[ItemsControl].((vm:CloudFolderPickerViewModel)DataContext).NavigateToBreadcrumbCommand}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="/" Classes="caption" Classes.secondary="True" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" IsVisible="{Binding IsLoading}" />

        <!-- Main Content Area -->
        <Grid>
            <!-- Error State -->
            <Border IsVisible="{Binding HasError}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ErrorMessage}" Classes="danger" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" />
                    <Button Content="{loc:Loc common.retry}" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Empty State -->
            <StackPanel IsVisible="{Binding !Folders.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{loc:Loc cloud_picker.empty}" Classes="secondary" TextAlignment="Center" />
            </StackPanel>

            <!-- Folders List -->
            <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                     DoubleTapped="OnFolderDoubleTapped"
                     Background="Transparent" BorderThickness="0" Padding="8">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CloudFolderItemViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,6">
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                                    Background="{DynamicResource AccentSubtle}" Margin="0,0,12,0">
                                <Path Classes="ico" Data="{StaticResource IconFolders}" Width="16" Height="16"
                                      Stroke="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ModifiedDisplay}" Classes="caption"
                                       Classes.secondary="True" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
