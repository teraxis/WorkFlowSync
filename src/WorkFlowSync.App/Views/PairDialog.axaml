<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkFlowSync.App.ViewModels"
        xmlns:app="using:WorkFlowSync.App"
        x:Class="WorkFlowSync.App.Views.PairDialog"
        x:DataType="vm:PairViewModel"
        Title="Пара папок"
        Width="760" Height="720" MinWidth="620" MinHeight="560"
        Background="{DynamicResource SurfaceCanvas}"
        WindowStartupLocation="CenterOwner">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="24,20,24,14">
            <StackPanel Spacing="3">
                <TextBlock x:Name="HeaderText" Classes="display" Text="Нова пара" />
                <TextBlock Classes="secondary"
                           Text="Мережева папка тільки читається. Локальна — ваша: усе, що ви в ній видалите чи зміните, програма більше не чіпає." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="24,14" Background="{DynamicResource SurfaceRail}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="ErrorText" Classes="danger" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Скасувати" Click="OnCancel" IsCancel="True" MinWidth="110" />
                    <Button Content="Зберегти пару" Click="OnOk" IsDefault="True" Classes="primary" MinWidth="140" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Margin="24,0,10,8" AllowAutoHide="False" Padding="0,0,12,0">
            <StackPanel Spacing="12">

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="ЩО І КУДИ" />

                        <Grid ColumnDefinitions="160,*,Auto" RowDefinitions="Auto,10,Auto,10,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Назва пари" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name}" Watermark="наприклад: Засідання ВРП" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Мережева папка" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Source}" Classes="mono" Watermark="\\server\share\папка" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Огляд…" Margin="8,0,0,0" Click="OnBrowseSource" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Локальна папка" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Target}" Classes="mono" Watermark="D:\OneDrive\…" />
                            <Button Grid.Row="4" Grid.Column="2" Content="Огляд…" Margin="8,0,0,0" Click="OnBrowseTarget" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="ПРАВИЛА" />

                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,4,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Лінки в джерелі" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:PairViewModel.LinkModes}" SelectedItem="{Binding Links}" Width="200" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="caption"
                                       Text="Follow — копіювати вміст як звичайну папку (потрібно для OneDrive); Skip — не заходити в лінки." />
                        </Grid>

                        <Grid ColumnDefinitions="160,*">
                            <TextBlock Grid.Column="0" Text="Зберігати" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <CheckBox IsChecked="{Binding HasRetention}" Content="лише те, що з'явилося за останні" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding RetentionDays}" Minimum="1" Maximum="36500" Increment="30"
                                               FormatString="0" Width="130" IsEnabled="{Binding HasRetention}" />
                                <TextBlock Text="днів" VerticalAlignment="Center" Classes="secondary" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="caption"
                                   Text="Старіші файли переносяться в Кошик і більше не повертаються. Файли, які ви редагували локально, це не зачіпає." />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section" Text="ВИКЛЮЧЕННЯ" />
                        <TextBlock Classes="caption"
                                   Text="По одному шаблону в рядку, відносно мережевої папки. Приклади:   \Тимчасове    *.tmp    \Палата\*Робочий.docx" />
                        <Border Classes="sunken" Padding="2">
                            <TextBox Text="{Binding ExcludeText}" AcceptsReturn="True" TextWrapping="NoWrap" Classes="mono"
                                     BorderThickness="0" Background="Transparent" MinHeight="130" VerticalContentAlignment="Top" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
