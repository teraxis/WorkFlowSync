<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WorkFlowSync.App.Views.TroubleshootingOptionsWindow"
        Width="540" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceCanvas}" ShowInTaskbar="False">
    <StackPanel Margin="22" Spacing="12">
        <TextBlock x:Name="HeadingText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" />
        <CheckBox x:Name="PathsCheck" Checked="OnSelectionChanged" Unchecked="OnSelectionChanged" />
        <TextBlock x:Name="PathsUnavailableText" IsVisible="False" Margin="26,-8,0,0" TextWrapping="Wrap" FontSize="12" />
        <CheckBox x:Name="AuditCheck" Checked="OnSelectionChanged" Unchecked="OnSelectionChanged" />
        <CheckBox x:Name="RestoreCheck" Checked="OnSelectionChanged" Unchecked="OnSelectionChanged" />
        <TextBlock x:Name="AuditUnavailableText" IsVisible="False" Margin="26,-8,0,0" TextWrapping="Wrap" FontSize="12" />
        <TextBlock x:Name="PauseHintText" TextWrapping="Wrap" FontSize="12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="CancelButton" Click="OnCancel" IsCancel="True" />
            <Button x:Name="ContinueButton" Classes="primary" Click="OnContinue" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
