<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkFlowSync.App.ViewModels"
        xmlns:app="using:WorkFlowSync.App"
        xmlns:cfg="using:WorkFlowSync.Core.Config"
        x:Class="WorkFlowSync.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1080" Height="700" MinWidth="880" MinHeight="560"
        Background="{DynamicResource SurfaceCanvas}"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="248,*">

        <!-- ═══════════════════════════ navigation rail ═══════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceRail}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- identity -->
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,18" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="{DynamicResource RadiusSm}"
                                Background="{DynamicResource Accent}">
                            <Path Classes="ico" Data="{StaticResource IconRefresh}" Width="17" Height="17"
                                  Stroke="{DynamicResource TextOnAccent}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WorkFlowSync" FontWeight="SemiBold" FontSize="14.5" />
                            <TextBlock Classes="caption" Text="{Binding Version}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Classes="nav" SelectedIndex="{Binding SelectedPage}">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Path Classes="ico" Data="{StaticResource IconFolders}" Width="17" Height="17" />
                            <TextBlock Text="Папки" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Path Classes="ico" Data="{StaticResource IconActivity}" Width="17" Height="17" />
                            <TextBlock Text="Синхронізація" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Path Classes="ico" Data="{StaticResource IconSettings}" Width="17" Height="17" />
                            <TextBlock Text="Налаштування" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════ content ═══════════════════════════ -->
        <DockPanel Grid.Column="1">

            <!-- page header -->
            <Border DockPanel.Dock="Top" Padding="28,20,28,16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="display" Text="{Binding PageTitle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding IsFoldersPage}">
                        <Button Classes="primary" Click="OnAddPair">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="ico" Data="{StaticResource IconPlus}" />
                                <TextBlock Text="Додати пару" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- action bar -->
            <Border DockPanel.Dock="Bottom" Padding="28,14" Background="{DynamicResource SurfaceRail}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="oneline" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0"
                               ToolTip.Tip="{Binding StatusText}"
                               Foreground="{Binding StatusIsError, Converter={x:Static app:Converters.StatusText}}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="Перевірити" Command="{Binding CheckConfigCommand}" />
                        <Button Content="Скасувати зміни" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsDirty}" />
                        <Button Classes="primary" Content="Зберегти" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" MinWidth="110" />
                    </StackPanel>
                </Grid>
            </Border>

            <Panel Margin="28,0,28,4">

                <!-- ────────────────────────── page: folders ────────────────────────── -->
                <Panel IsVisible="{Binding IsFoldersPage}">
                    <ListBox Classes="rows" ItemsSource="{Binding Pairs}" SelectedItem="{Binding SelectedPair}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PairViewModel">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                                            <!-- name + state -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Classes="title oneline" VerticalAlignment="Center" MaxWidth="360" />
                                                <Border Classes="badge" Classes.success="{Binding Enabled}">
                                                    <TextBlock Text="{Binding StateSummary}" />
                                                </Border>
                                                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="70" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- paths + facts -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3" Margin="0,6,0,0">
                                                <Grid ColumnDefinitions="*,Auto,*">
                                                    <TextBlock Grid.Column="0" Classes="caption mono oneline" Text="{Binding Source}"
                                                               ToolTip.Tip="{Binding Source}" />
                                                    <Path Grid.Column="1" Classes="ico" Data="{StaticResource IconArrowRight}" Width="12" Height="12"
                                                          Margin="8,0" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5" />
                                                    <TextBlock Grid.Column="2" Classes="caption mono oneline" Text="{Binding Target}"
                                                               ToolTip.Tip="{Binding Target}" />
                                                </Grid>
                                                <TextBlock Classes="caption oneline" Text="{Binding Facts}" />
                                            </StackPanel>

                                            <!-- actions -->
                                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="6" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <Button Classes="icon accentsoft" Click="OnTogglePair" ToolTip.Tip="{Binding ToggleTip}">
                                                    <Path Classes="icof" Data="{Binding ToggleIcon}" Width="15" Height="15" />
                                                </Button>
                                                <Button Classes="ghost icon" Click="OnRunPair" ToolTip.Tip="Перевірити цю пару зараз (працює й на паузі)">
                                                    <Path Classes="ico" Data="{StaticResource IconRefresh}" />
                                                </Button>
                                                <Button Classes="ghost icon" Click="OnEditPair" ToolTip.Tip="Редагувати пару">
                                                    <Path Classes="ico" Data="{StaticResource IconPencil}" />
                                                </Button>
                                                <Button Classes="ghost icon" Click="OnDeletePair" ToolTip.Tip="Видалити пару зі списку">
                                                    <Path Classes="ico" Data="{StaticResource IconTrash}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- empty state -->
                    <Border Classes="card" IsVisible="{Binding !HasPairs}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="40,32" MaxWidth="460">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <Path Classes="ico" Data="{StaticResource IconFolders}" Width="34" Height="34" StrokeThickness="1.3"
                                  Stroke="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                            <TextBlock Classes="title" Text="Пар ще немає" HorizontalAlignment="Center" />
                            <TextBlock Classes="secondary" TextAlignment="Center"
                                       Text="Додайте мережеву папку, за якою стежити, і локальну папку для дзеркала. Джерело лише читається." />
                            <Button Classes="primary" Content="Додати пару" Click="OnAddPair" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Panel>

                <!-- ────────────────────────── page: activity ────────────────────────── -->
                <Panel IsVisible="{Binding IsActivityPage}">
                <DockPanel DataContext="{Binding Run}" x:DataType="vm:RunViewModel">

                    <Border DockPanel.Dock="Top" Classes="card" Padding="16,14" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding BackgroundStatus}" FontWeight="SemiBold" />
                                <TextBlock Classes="caption"
                                           Text="Автоматично перевіряються пари у стані «виконується» (зелена позначка на сторінці «Папки»). Закриття вікна перевірку не зупиняє." />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <Button Classes="ghost" Command="{Binding DryRunCommand}"
                                        ToolTip.Tip="Показати, що буде зроблено, не змінюючи жодного файлу">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="ico" Data="{StaticResource IconCheck}" />
                                        <TextBlock Text="Показати план" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="primary" Command="{Binding RunNowCommand}" MinWidth="150">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="ico" Data="{StaticResource IconRefresh}" />
                                        <TextBlock Text="Синхронізувати" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="danger icon" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}"
                                        ToolTip.Tip="Зупинити поточний прохід">
                                    <Path Classes="icof" Data="{StaticResource IconStopFill}" />
                                </Button>
                            </StackPanel>
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" IsIndeterminate="True" IsVisible="{Binding IsRunning}" Margin="0,12,0,0" />
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top" Classes="card" Padding="16,12" Margin="0,0,0,12"
                            IsVisible="{Binding LastResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding LastResult}" FontWeight="SemiBold" />
                    </Border>

                    <Border DockPanel.Dock="Top" Classes="sunken" Padding="16,12" Margin="0,0,0,12">
                        <TextBlock Classes="mono" Text="{Binding Summary}" />
                    </Border>

                    <Border Classes="card" Padding="6" Margin="0,0,0,8">
                        <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 x:Name="RunLog" Classes="mono" BorderThickness="0" Background="Transparent" Padding="8,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </DockPanel>
                </Panel>

                <!-- ────────────────────────── page: settings ────────────────────────── -->
                <ScrollViewer IsVisible="{Binding IsSettingsPage}">
                    <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,8">

                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section" Text="РОЗКЛАД" />
                                <Grid ColumnDefinitions="240,*">
                                    <TextBlock Grid.Column="0" Text="Інтервал перевірки" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <NumericUpDown Value="{Binding IntervalMinutes}" Minimum="1" Maximum="1440" Increment="5"
                                                       FormatString="0" Width="130" />
                                        <TextBlock Text="хвилин" VerticalAlignment="Center" Classes="secondary" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="caption"
                                           Text="Період між автоматичними проходами. Зміну підхоплює і фоновий режим, і трей; завдання Планувальника треба перестворити перемикачем нижче." />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="12" DataContext="{Binding Autostart}" x:DataType="vm:AutostartViewModel">
                                <TextBlock Classes="section" Text="АВТОМАТИЧНИЙ ЗАПУСК" />
                                <CheckBox IsChecked="{Binding StartupEnabled}" IsEnabled="{Binding CanAutostart}"
                                          Content="Запускати разом із Windows" />
                                <StackPanel Margin="26,0,0,0" Spacing="4" IsEnabled="{Binding StartupEnabled}">
                                    <RadioButton GroupName="StartupMode" IsChecked="{Binding StartupInTray}" IsEnabled="{Binding GuiAvailable}"
                                                 Content="зі значком в області сповіщень" />
                                    <RadioButton GroupName="StartupMode" IsChecked="{Binding !StartupInTray}" IsEnabled="{Binding ConsoleAvailable}"
                                                 Content="фоновим процесом без вікна" />
                                </StackPanel>
                                <Border Classes="divider" />
                                <CheckBox IsChecked="{Binding TaskEnabled}" IsEnabled="{Binding ConsoleAvailable}"
                                          Content="Завдання Планувальника Windows: один прохід за інтервалом" />
                                <TextBlock Classes="caption" Text="{Binding TaskHint}" />
                                <TextBlock Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{Binding MessageIsError, Converter={x:Static app:Converters.StatusText}}" />
                                <TextBlock Classes="caption" Text="{Binding StartupHint}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section" Text="МІГРАЦІЯ З FREEFILESYNC" />
                                <TextBlock Classes="caption"
                                           Text="Перенести з файлу налаштувань FreeFileSync шаблони виключень і позначки «не повертати», щоб після переходу не повернувся жоден раніше видалений файл." />
                                <Button Classes="ghost" Click="OnImportFfs" IsEnabled="{Binding HasPairs}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="ico" Data="{StaticResource IconImport}" />
                                        <TextBlock Text="Вибрати файл .ffs_batch…" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section" Text="ВИГЛЯД" />
                                <Grid ColumnDefinitions="240,*">
                                    <TextBlock Grid.Column="0" Text="Тема оформлення" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="230"
                                              HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="cfg:AppTheme">
                                                <TextBlock Text="{Binding Converter={x:Static app:Converters.ThemeName}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Classes="caption" Text="«Як у Windows» перемикається разом із системною темою." />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section" Text="ПРОДУКТИВНІСТЬ СКАНЕРА" />
                                <Grid ColumnDefinitions="240,*" RowDefinitions="Auto,10,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Паралельних листингів" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding ScanParallelism}" Minimum="1" Maximum="64"
                                                   FormatString="0" Width="130" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Буфер листингу, КБ" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ScanBufferKb}" Minimum="4" Maximum="4096"
                                                   Increment="64" FormatString="0" Width="130" HorizontalAlignment="Left" />
                                </Grid>
                                <TextBlock Classes="caption"
                                           Text="Великий буфер зменшує кількість мережевих запитів до SMB-сервера; типово 256 КБ. Паралелізм 8–16 для локальної мережі." />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section" Text="ФАЙЛИ ПРОГРАМИ" />
                                <TextBlock Classes="secondary"
                                           Text="Усе, що потрібно програмі — config.json, база стану та журнали — зберігається в папці, з якої вона запущена. Папку можна переносити разом із файлами." />
                                <Grid ColumnDefinitions="240,*,Auto" RowDefinitions="Auto">
                                    <TextBlock Grid.Column="0" Text="Папка програми" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding AppFolder}" IsReadOnly="True" Classes="mono" />
                                    <Button Grid.Column="2" Content="Відкрити" Margin="8,0,0,0" Click="OnOpenAppFolder" />
                                </Grid>
                                <Border Classes="divider" />
                                <Grid ColumnDefinitions="240,*" RowDefinitions="Auto,4,Auto,10,Auto,4,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="База стану" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StatePath}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="caption mono oneline" Text="{Binding StateFullPath}" ToolTip.Tip="{Binding StateFullPath}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Папка логів" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LogPath}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Classes="caption mono oneline" Text="{Binding LogFullPath}" ToolTip.Tip="{Binding LogFullPath}" />
                                </Grid>
                                <TextBlock Classes="caption" Text="Відносні шляхи відлічуються від папки програми; за замовчуванням усе лежить саме там." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </DockPanel>
    </Grid>
</Window>
