<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkFlowSync.App.ViewModels"
        xmlns:app="using:WorkFlowSync.App"
        x:Class="WorkFlowSync.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="900" Height="600" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- Status bar + main actions -->
        <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Перевірити" Command="{Binding CheckConfigCommand}" />
                    <Button Content="Скасувати зміни" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsDirty}" />
                    <Button Content="Зберегти" Command="{Binding SaveCommand}" Classes="accent" IsEnabled="{Binding IsDirty}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{Binding StatusIsError, Converter={x:Static app:Converters.ErrorBrush}}" />
            </DockPanel>
        </Border>

        <TabControl TabStripPlacement="Left" Padding="16,8" SelectedIndex="0">

            <!-- ===================== Папки ===================== -->
            <TabItem Header="Папки">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.8"
                               Text="Кожна пара — це мережева папка, за якою стежимо, і локальна папка (у OneDrive), куди складаємо копію. ▶ — перевіряти автоматично за інтервалом (зелений кружечок), ⏸ — пауза. Джерело лише читається; локальне дзеркало — ваше." />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Додати пару…" Click="OnAddPair" />
                        <Button Content="Редагувати…" Click="OnEditPair" IsEnabled="{Binding HasSelection}" />
                        <Button Content="Видалити" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding HasSelection}" />
                        <Button Content="Імпорт із FreeFileSync…" Click="OnImportFfs" Margin="16,0,0,0" IsEnabled="{Binding HasPairs}" />
                    </StackPanel>

                    <Panel>
                        <ListBox ItemsSource="{Binding Pairs}" SelectedItem="{Binding SelectedPair}"
                                 DoubleTapped="OnEditPair">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PairViewModel">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="4">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="11" Height="11" VerticalAlignment="Center"
                                                     Fill="{Binding Enabled, Converter={x:Static app:Converters.StateDot}}"
                                                     ToolTip.Tip="{Binding StateSummary}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StateSummary}" Opacity="0.7" VerticalAlignment="Center" />
                                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" Height="4" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Source}" />
                                            <TextBlock Text="→" Opacity="0.6" />
                                            <TextBlock Text="{Binding Target}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="12" Opacity="0.7">
                                            <TextBlock Text="{Binding LinksSummary}" />
                                            <TextBlock Text="{Binding RetentionSummary, StringFormat='зберігати: {0}'}" />
                                            <TextBlock Text="{Binding ExcludeCount, StringFormat='виключень: {0}'}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Content="{Binding ToggleGlyph}" Click="OnTogglePair" Width="40" FontSize="16"
                                                    ToolTip.Tip="{Binding ToggleTip}" />
                                            <Button Content="Перевірити зараз" Click="OnRunPair" MinWidth="130"
                                                    ToolTip.Tip="Одноразова синхронізація саме цієї пари (працює й на паузі)" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock IsVisible="{Binding !HasPairs}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.6" Text="Пар ще немає. Натисніть «Додати пару…»" />
                    </Panel>
                </DockPanel>
            </TabItem>

            <!-- ===================== Налаштування ===================== -->
            <TabItem Header="Налаштування">
                <ScrollViewer>
                    <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">

                        <TextBlock Text="Розклад" FontWeight="SemiBold" FontSize="16" />
                        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto" >
                            <TextBlock Grid.Column="0" Text="Інтервал перевірки, хв" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding IntervalMinutes}" Minimum="1" Maximum="1440" Increment="5" FormatString="0" Width="140" HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                                   Text="Період між проходами в резидентному режимі та для завдання Планувальника. Зміну інтервалу резидент підхопить сам; завдання Планувальника — перестворіть перемикачем нижче." />

                        <TextBlock Text="Автоматичний запуск" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,0" />
                        <StackPanel DataContext="{Binding Autostart}" x:DataType="vm:AutostartViewModel" Spacing="6">
                            <CheckBox IsChecked="{Binding StartupEnabled}" IsEnabled="{Binding CanAutostart}"
                                      Content="Запускати при вході в Windows і перевіряти за інтервалом" />
                            <StackPanel Margin="28,0,0,4" Spacing="2" IsEnabled="{Binding StartupEnabled}">
                                <RadioButton GroupName="StartupMode" IsChecked="{Binding StartupInTray}" IsEnabled="{Binding GuiAvailable}"
                                             Content="в області сповіщень (значок біля годинника, вікно під рукою)" />
                                <RadioButton GroupName="StartupMode" IsChecked="{Binding !StartupInTray}" IsEnabled="{Binding ConsoleAvailable}"
                                             Content="фоновим процесом без вікна" />
                            </StackPanel>
                            <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding StartupHint}" Margin="28,0,0,4" />
                            <CheckBox IsChecked="{Binding TaskEnabled}" IsEnabled="{Binding ConsoleAvailable}"
                                      Content="Завдання Планувальника Windows: один прохід за інтервалом" />
                            <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding TaskHint}" Margin="28,0,0,4" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                       Foreground="{Binding MessageIsError, Converter={x:Static app:Converters.ErrorBrush}}" />
                            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                                       Text="Достатньо одного способу. Обидва працюють від звичайного користувача, без прав адміністратора." />
                        </StackPanel>

                        <TextBlock Text="Файли програми" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,8,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="База стану" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StatePath}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Папка логів" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LogPath}" />
                        </Grid>
                        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                                   Text="Відносні шляхи — від папки, де лежить config.json (поруч з програмою)." />

                        <TextBlock Text="Продуктивність сканера" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,8,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Паралельних листингів" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding ScanParallelism}" Minimum="1" Maximum="64" FormatString="0" Width="140" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Буфер листингу, КБ" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ScanBufferKb}" Minimum="4" Maximum="4096" Increment="64" FormatString="0" Width="140" HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                                   Text="Великий буфер зменшує кількість мережевих запитів до SMB-сервера; типово 256 КБ. Паралелізм 8–16 для локальної мережі." />

                        <TextBlock Text="Конфігурація" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,0" />
                        <TextBox Text="{Binding ConfigPath}" IsReadOnly="True" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Стан ===================== -->
            <TabItem Header="Стан">
                <DockPanel DataContext="{Binding Run}" x:DataType="vm:RunViewModel">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" FontFamily="Consolas,monospace" Margin="0,0,0,10" />

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="Показати план (нічого не змінює)" Command="{Binding DryRunCommand}" />
                        <Button Content="Виконати зараз" Command="{Binding RunNowCommand}" Classes="accent" />
                        <Button Content="Зупинити" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" Width="140" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8" CornerRadius="4"
                            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding BackgroundStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Opacity="0.6" TextWrapping="Wrap"
                                       Text="Автоматично перевіряються пари у стані «виконується» (зелений кружечок на вкладці «Папки»). Закриття вікна перевірку не зупиняє — програма лишається в області сповіщень; щоб вона вмикалася після перезавантаження, увімкніть автозапуск у «Налаштуваннях»." />
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding LastResult}" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold" />

                    <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas,monospace" FontSize="12" x:Name="RunLog"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
