<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WorkFlowSync.App.Views.RecoveryPreviewWindow"
        Width="840" Height="590" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceCanvas}">
    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <TextBlock x:Name="SummaryText" Grid.Row="0" TextWrapping="Wrap" FontSize="16" />
        <TextBlock x:Name="ListHintText" Grid.Row="1" TextWrapping="Wrap" />
        <TextBox x:Name="RowsText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" FontFamily="Consolas"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <CheckBox x:Name="RestoreDeletedCheck" Grid.Row="3" IsVisible="False" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ExportButton" Click="OnExport" />
            <Button x:Name="CancelButton" Click="OnCancel" IsCancel="True" />
            <Button x:Name="ApplyButton" Classes="primary" Click="OnApply" />
        </StackPanel>
    </Grid>
</Window>
