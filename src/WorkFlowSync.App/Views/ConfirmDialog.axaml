<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WorkFlowSync.App.Views.ConfirmDialog"
        Width="460" SizeToContent="Height" CanResize="False"
        Background="{DynamicResource SurfaceCanvas}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="24" Spacing="10">
        <TextBlock x:Name="TitleText" Classes="title" />
        <TextBlock x:Name="BodyText" Classes="secondary" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Скасувати" Click="OnCancel" IsCancel="True" MinWidth="110" />
            <Button x:Name="ConfirmButton" Classes="primary danger" Click="OnConfirm" IsDefault="True" MinWidth="110" />
        </StackPanel>
    </StackPanel>
</Window>
