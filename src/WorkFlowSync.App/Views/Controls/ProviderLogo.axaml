<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WorkFlowSync.App.Views.Controls.ProviderLogo">
    <Panel>
        <!-- Google Drive: Official 4-color / 3-color vector logo -->
        <Viewbox x:Name="GdriveBox" Stretch="Uniform" IsVisible="True">
            <Canvas Width="87.3" Height="78">
                <Path Fill="#0066da" Data="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" />
                <Path Fill="#00ac47" Data="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" />
                <Path Fill="#ea4335" Data="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" />
                <Path Fill="#00832d" Data="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" />
                <Path Fill="#2684fc" Data="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" />
                <Path Fill="#ffba00" Data="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" />
            </Canvas>
        </Viewbox>

        <!-- Microsoft OneDrive: Official Microsoft 3D/Fluent OneDrive Logo provided by user -->
        <Viewbox x:Name="OneDriveBox" Stretch="Uniform" IsVisible="False">
            <Canvas Width="36" Height="36">
                <!-- Back deep blue layer -->
                <Path Data="M10.0612 10.0071C4.63381 10.0072 0.576899 14.4499 0.271484 19.3991C0.46055 20.4655 1.08197 22.5713 2.05512 22.4632C3.27156 22.328 6.33519 22.4632 8.94828 17.7326C10.8571 14.2769 14.7838 10.007 10.0612 10.0071Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0.0" Color="#4894FE" />
                            <GradientStop Offset="0.7" Color="#0934B3" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- Middle blue cloud body layer -->
                <Path Data="M8.80561 11.8538C6.98126 14.7423 4.52553 18.8811 3.69671 20.1836C2.71151 21.7317 0.102357 21.074 0.318506 18.8549C0.297198 19.0351 0.280832 19.2167 0.269548 19.3995C-0.0873823 25.173 4.49016 29.9676 10.1863 29.9676C16.4643 29.9676 31.4367 22.1455 29.9215 14.3081C28.3245 9.70109 23.8357 6.39673 18.7486 6.39673C13.6615 6.39673 10.4012 9.32752 8.80561 11.8538Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0.16" Color="#23C0FE" />
                            <GradientStop Offset="0.53" Color="#1C91FF" />
                            <GradientStop Offset="1.0" Color="#033ACC" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- Front cyan/bright cloud layer -->
                <Path Data="M10.0947 29.9703C10.0947 29.9703 25.0847 29.9998 27.6273 29.9998C32.2416 29.9998 35.75 26.2326 35.75 21.8368C35.75 17.4409 32.1712 13.6965 27.6274 13.6965C23.0835 13.6965 20.4668 17.0959 18.5015 20.8065C16.1984 25.1546 13.2606 29.9182 10.0947 29.9703Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                            <GradientStop Offset="0.0" Color="#0086FF" />
                            <GradientStop Offset="0.5" Color="#00BBFF" />
                            <GradientStop Offset="1.0" Color="#4BFDE8" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Canvas>
        </Viewbox>

        <!-- Dropbox: Official Dropbox open box -->
        <Viewbox x:Name="DropboxBox" Stretch="Uniform" IsVisible="False">
            <Canvas Width="24" Height="24">
                <Path Fill="#0061FE" Data="M6 1.807L0 5.629l6 3.822 6.001-3.822L6 1.807zM18 1.807l-6 3.822 6 3.822 6-3.822-6-3.822zM0 13.274l6 3.822 6.001-3.822L6 9.452l-6 3.822zM18 9.452l-6 3.822 6 3.822 6-3.822-6-3.822zM6 18.371l6.001 3.822 6-3.822-6-3.822L6 18.371z" />
            </Canvas>
        </Viewbox>

