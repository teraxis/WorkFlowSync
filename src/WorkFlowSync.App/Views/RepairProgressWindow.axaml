<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WorkFlowSync.App.Views.RepairProgressWindow"
        Width="460" Height="150" CanResize="False"
        Background="{DynamicResource SurfaceCanvas}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock x:Name="StageText" TextWrapping="Wrap" />
        <ProgressBar x:Name="StageProgress" Height="12" IsIndeterminate="True" />
    </StackPanel>
</Window>
