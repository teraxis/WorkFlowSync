<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Design tokens. Every colour used by the app comes from here, so light and dark stay in step.
        Palette: one calm blue accent, a neutral grey ramp, three semantic colours. No shadows —
        depth comes from surface steps and hairline borders.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <!-- surfaces: page → rail → card → raised -->
            <SolidColorBrush x:Key="SurfaceCanvas" Color="#F4F6F9" />
            <SolidColorBrush x:Key="SurfaceRail" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceCard" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSunken" Color="#EEF1F6" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#E9EDF4" />
            <SolidColorBrush x:Key="SurfaceSelected" Color="#E4ECFF" />

            <!-- lines -->
            <SolidColorBrush x:Key="BorderSubtle" Color="#E3E7EE" />
            <SolidColorBrush x:Key="BorderStrong" Color="#CBD3E0" />

            <!-- text -->
            <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
            <SolidColorBrush x:Key="TextSecondary" Color="#4B5565" />
            <!-- Muted carries the paths and the facts line, i.e. most of what the folders page actually says.
                 Was #7A8496: 3.77:1 on a card, 3.48:1 on the canvas — under the 4.5:1 minimum, and at caption
                 size that is exactly what "the text is not readable" looks like. Now 4.7-5.3:1 on every
                 surface, while staying a clear step lighter than TextSecondary. -->
            <SolidColorBrush x:Key="TextMuted" Color="#636C7B" />
            <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

            <!-- accent: deep enough that white on it clears 7:1 (was #2C62E8 = 5.4:1) -->
            <SolidColorBrush x:Key="Accent" Color="#1A47CC" />
            <SolidColorBrush x:Key="AccentHover" Color="#163CAF" />
            <SolidColorBrush x:Key="AccentPressed" Color="#123296" />
            <SolidColorBrush x:Key="AccentSoft" Color="#DEE8FF" />
            <SolidColorBrush x:Key="AccentText" Color="#1E46AC" />

            <!-- semantic -->
            <SolidColorBrush x:Key="Success" Color="#177245" />
            <SolidColorBrush x:Key="SuccessSoft" Color="#DCF3E6" />
            <SolidColorBrush x:Key="Warning" Color="#B45309" />
            <SolidColorBrush x:Key="WarningSoft" Color="#FCEFDC" />
            <SolidColorBrush x:Key="Danger" Color="#B42318" />
            <SolidColorBrush x:Key="DangerSoft" Color="#FBE4E2" />
            <SolidColorBrush x:Key="Neutral" Color="#8A94A6" />
            <SolidColorBrush x:Key="NeutralSoft" Color="#E8EBF0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SurfaceCanvas" Color="#11151C" />
            <SolidColorBrush x:Key="SurfaceRail" Color="#161B23" />
            <SolidColorBrush x:Key="SurfaceCard" Color="#1A2029" />
            <SolidColorBrush x:Key="SurfaceSunken" Color="#141922" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#222A35" />
            <SolidColorBrush x:Key="SurfaceSelected" Color="#1E2A45" />

            <SolidColorBrush x:Key="BorderSubtle" Color="#262E3A" />
            <SolidColorBrush x:Key="BorderStrong" Color="#38424F" />

            <SolidColorBrush x:Key="TextPrimary" Color="#E9EDF3" />
            <SolidColorBrush x:Key="TextSecondary" Color="#AEB8C7" />
            <SolidColorBrush x:Key="TextMuted" Color="#7E8899" />
            <!-- On a dark canvas the accent has to stay bright to read as an accent, so the label goes dark
                 instead: white on #4C82F7 is only 3.5:1, which fails the 4.5:1 minimum. -->
            <SolidColorBrush x:Key="TextOnAccent" Color="#0B1220" />

            <SolidColorBrush x:Key="Accent" Color="#4C82F7" />
            <SolidColorBrush x:Key="AccentHover" Color="#6394FF" />
            <SolidColorBrush x:Key="AccentPressed" Color="#4477EC" />
            <SolidColorBrush x:Key="AccentSoft" Color="#1C2A45" />
            <SolidColorBrush x:Key="AccentText" Color="#8FB3FF" />

            <SolidColorBrush x:Key="Success" Color="#3DD07F" />
            <SolidColorBrush x:Key="SuccessSoft" Color="#14301F" />
            <SolidColorBrush x:Key="Warning" Color="#E3A857" />
            <SolidColorBrush x:Key="WarningSoft" Color="#33270F" />
            <SolidColorBrush x:Key="Danger" Color="#F0776B" />
            <SolidColorBrush x:Key="DangerSoft" Color="#3A1D1A" />
            <SolidColorBrush x:Key="Neutral" Color="#6E7787" />
            <SolidColorBrush x:Key="NeutralSoft" Color="#222A35" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- shape and rhythm: 4px grid, three radii -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <x:Double x:Key="FontDisplay">22</x:Double>
    <x:Double x:Key="FontTitle">16</x:Double>
    <x:Double x:Key="FontBody">13.5</x:Double>
    <x:Double x:Key="FontCaption">12</x:Double>
    <x:Double x:Key="FontMono">12.5</x:Double>
</ResourceDictionary>
