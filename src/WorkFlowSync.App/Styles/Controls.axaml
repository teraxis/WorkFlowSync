<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Control styles on top of FluentTheme. Everything reads tokens from Palette.axaml, so the two
        themes need no duplicated rules. Naming: .primary / .secondary / .ghost / .danger for buttons,
        .card / .sunken for containers, .display / .title / .body / .caption / .mono for text.
    -->

    <Design.PreviewWith>
        <Border Padding="24" Background="{DynamicResource SurfaceCanvas}">
            <StackPanel Spacing="12" Width="320">
                <TextBlock Classes="display" Text="Заголовок" />
                <TextBlock Classes="body" Text="Звичайний текст" />
                <TextBlock Classes="caption" Text="Підпис" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Основна" />
                    <Button Classes="secondary" Content="Другорядна" />
                    <Button Classes="ghost" Content="Тиха" />
                </StackPanel>
                <TextBox Watermark="Поле вводу" />
                <CheckBox Content="Прапорець" IsChecked="True" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- ============================================================ typography -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.display">
        <Setter Property="FontSize" Value="{DynamicResource FontDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{DynamicResource FontTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="LetterSpacing" Value="0.8" />
    </Style>

    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
        <Setter Property="FontSize" Value="{DynamicResource FontMono}" />
    </Style>

    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>

    <!-- ============================================================ containers -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.sunken">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- ============================================================ buttons -->

    <Style Selector="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextOnAccent}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Danger}" />
    </Style>

    <!-- square icon button (play/pause on a row) -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    </Style>

    <Style Selector="Button.accentsoft">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="Button.accentsoft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextOnAccent}" />
    </Style>

    <!-- icons: outline ones are stroked, solid ones are filled; colour follows the button class -->
    <Style Selector="Path.ico">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Path.icof">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button Path.ico">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button Path.icof">
        <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style Selector="Button.primary Path.ico">
        <Setter Property="Stroke" Value="{DynamicResource TextOnAccent}" />
    </Style>
    <Style Selector="Button.primary Path.icof">
        <Setter Property="Fill" Value="{DynamicResource TextOnAccent}" />
    </Style>

    <Style Selector="Button.accentsoft Path.ico">
        <Setter Property="Stroke" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="Button.accentsoft Path.icof">
        <Setter Property="Fill" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="Button.accentsoft:pointerover Path.icof">
        <Setter Property="Fill" Value="{DynamicResource TextOnAccent}" />
    </Style>
    <Style Selector="Button.accentsoft:pointerover Path.ico">
        <Setter Property="Stroke" Value="{DynamicResource TextOnAccent}" />
    </Style>

    <Style Selector="Button.danger Path.ico">
        <Setter Property="Stroke" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Button.danger Path.icof">
        <Setter Property="Fill" Value="{DynamicResource Danger}" />
    </Style>

    <Style Selector="Button:disabled Path.ico">
        <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Button:disabled Path.icof">
        <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- rail icons follow the item state -->
    <Style Selector="ListBox.nav ListBoxItem Path.ico">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected Path.ico">
        <Setter Property="Stroke" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover Path.ico">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- ============================================================ inputs -->

    <Style Selector="TextBox">
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Neutral}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="1.6" />
    </Style>
    <Style Selector="TextBox[IsReadOnly=True] /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    </Style>

    <!-- Stepper (Views/Controls/Stepper): borderless box + quiet buttons inside one rounded frame -->
    <Style Selector="TextBox.stepper /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBox.stepper:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.stepper:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.stepper">
        <Setter Property="Width" Value="30" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.stepper:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    </Style>
    <Style Selector="Button.stepper:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
    </Style>

    <!-- scrollbars: a slim rail in its own lane, no arrow buttons, thumb from the palette -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="10" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ScrollBar /template/ Border#TrackRect, ScrollBar /template/ Rectangle#TrackRect">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ScrollBar Thumb">
        <Setter Property="Background" Value="{DynamicResource BorderStrong}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="MinHeight" Value="6" />
    </Style>
    <Style Selector="ScrollBar Thumb /template/ Border">
        <Setter Property="Background" Value="{DynamicResource BorderStrong}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    </Style>
    <Style Selector="ScrollBar Thumb:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Neutral}" />
    </Style>

    <!-- read-only single-line box (paths) -->
    <Style Selector="TextBox.oneline-box">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="AcceptsReturn" Value="False" />
    </Style>

    <!-- context menu (the ⋯ button on a pair) -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="200" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    </Style>
    <Style Selector="MenuItem.danger">
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="MenuItem.danger Path.ico">
        <Setter Property="Stroke" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="MenuItem Path.ico">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
    </Style>
    <Style Selector="MenuFlyoutPresenter Separator">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Margin" Value="6,4" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Neutral}" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    </Style>

    <Style Selector="CheckBox, RadioButton">
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Height" Value="4" />
    </Style>

    <!-- ============================================================ navigation rail -->

    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox.nav ListBoxItem">
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>

    <!-- ============================================================ pair list -->

    <Style Selector="ListBox.rows">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.rows ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- the card inside a row reacts instead, so selection reads as a highlighted card -->
    <Style Selector="ListBox.rows ListBoxItem Border.row">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover Border.row">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected Border.row">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <!-- ============================================================ badges -->

    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{DynamicResource NeutralSoft}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Border.badge.success">
        <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
    </Style>
    <Style Selector="Border.badge.success TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Success}" />
    </Style>

    <!-- ============================================================ misc -->

    <!-- single-line status text never pushes the action buttons around -->
    <Style Selector="TextBlock.oneline">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
        <Setter Property="MaxWidth" Value="360" />
    </Style>
</Styles>
