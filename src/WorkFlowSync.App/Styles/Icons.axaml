<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        24×24 icon geometries. Two families, because they are drawn differently:
          • outline icons are STROKED  → use <Path Classes="ico">   (open paths, no fill)
          • solid icons are FILLED     → use <Path Classes="icof">  (closed silhouettes)
        Colour comes from the Path.ico / Path.icof styles in Controls.axaml, per button class.
    -->

    <!-- ── outline ── -->
    <StreamGeometry x:Key="IconFolders">M3.5 7.2c0-1.2 1-2.2 2.2-2.2h2.9c.5 0 1 .2 1.4.6l1.1 1.1c.4.4.9.6 1.4.6h5.8c1.2 0 2.2 1 2.2 2.2v7.8c0 1.2-1 2.2-2.2 2.2H5.7c-1.2 0-2.2-1-2.2-2.2z</StreamGeometry>

    <StreamGeometry x:Key="IconSettings">M12 15.1a3.1 3.1 0 1 0 0-6.2 3.1 3.1 0 0 0 0 6.2z M19.3 13.1c.1-.4.1-.7.1-1.1s0-.7-.1-1.1l1.8-1.3-1.8-3.2-2.1.8c-.5-.4-1.1-.8-1.7-1L15 4h-3.7l-.4 2.2c-.6.2-1.2.6-1.7 1l-2.1-.8-1.8 3.2 1.7 1.3c0 .4-.1.7-.1 1.1s0 .7.1 1.1L5.3 15l1.8 3.2 2.1-.8c.5.4 1.1.8 1.7 1l.4 2.2H15l.4-2.2c.6-.2 1.2-.6 1.7-1l2.1.8 1.8-3.2z</StreamGeometry>

    <StreamGeometry x:Key="IconActivity">M3.5 12h3.8l2.4-6.6 4.8 13.2 2.4-6.6h3.6</StreamGeometry>

    <StreamGeometry x:Key="IconRefresh">M20.2 12a8.2 8.2 0 1 1-2.6-6 M20.4 4.2v5.4h-5.4</StreamGeometry>

    <StreamGeometry x:Key="IconPlus">M12 5.2v13.6 M5.2 12h13.6</StreamGeometry>

    <StreamGeometry x:Key="IconPencil">M4.2 19.8l4.3-1.1L19.6 7.6a1.9 1.9 0 0 0 0-2.7l-.5-.5a1.9 1.9 0 0 0-2.7 0L5.3 15.5z M14.8 6.4l2.8 2.8</StreamGeometry>

    <StreamGeometry x:Key="IconTrash">M4.8 6.8h14.4 M9.6 6.8V5.2c0-.7.5-1.2 1.2-1.2h2.4c.7 0 1.2.5 1.2 1.2v1.6 M6.8 6.8l.8 11.4c.1.9.8 1.6 1.7 1.6h5.4c.9 0 1.6-.7 1.7-1.6l.8-11.4</StreamGeometry>

    <StreamGeometry x:Key="IconImport">M12 3.4v9.8 M8.2 9.8l3.8 3.8 3.8-3.8 M4.4 16.4v2a2.4 2.4 0 0 0 2.4 2.4h10.4a2.4 2.4 0 0 0 2.4-2.4v-2</StreamGeometry>

    <StreamGeometry x:Key="IconArrowRight">M4.4 12h14.4 M13.4 6.8l5.4 5.2-5.4 5.2</StreamGeometry>

    <StreamGeometry x:Key="IconCheck">M5.2 12.4l4.8 4.8 8.8-10.4</StreamGeometry>

    <!-- ── solid ── -->
    <StreamGeometry x:Key="IconPlayFill">M8.4 5.6a.8.8 0 0 1 1.2-.7l9 6.4a.8.8 0 0 1 0 1.4l-9 6.4a.8.8 0 0 1-1.2-.7z</StreamGeometry>

